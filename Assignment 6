#include <stdio.h>

// Function declarations
long long factorial_without_recursion(int n);
long long factorial_with_recursion(int n);

int main() {
    int num;
    
    printf("Enter any input number (eg. 5): ");
    if (scanf("%d", &num) != 1) {
        printf("Invalid input.\n");
        return 1;
    }

    if (num < 0) {
        printf("Factorial of negative numbers is not defined.\n");
    } else {
        // 1. Without Recursion
        long long iter_res = factorial_without_recursion(num);
        printf("Output (Without Recursion): Factorial of number = %lld\n", iter_res);
        
        // 2. With Recursion
        long long rec_res = factorial_with_recursion(num);
        printf("Output (With Recursion): Factorial of number = %lld\n", rec_res);
    }

    return 0;
}

// 1. C function to compute factorial without recursion
long long factorial_without_recursion(int n) {
    long long fact = 1;
    for (int i = 1; i <= n; i++) {
        fact *= i;
    }
    return fact;
}

// 2. C function to compute factorial with recursion
long long factorial_with_recursion(int n) {
    // Base Case
    if (n == 0 || n == 1) {
        return 1;
    }
    // Recursive Case
    return n * factorial_with_recursion(n - 1);
}
