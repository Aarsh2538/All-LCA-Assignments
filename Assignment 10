#include <stdio.h>

int main()
{
    int year, month, day, days, i;
    int firstDay = 0;

    char *months[] = {
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    };

    int monthDays[] = {
        31, 28, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    printf("Enter year: ");
    scanf("%d", &year);

    // Check leap year
    if ((year % 400 == 0) ||
        (year % 4 == 0 && year % 100 != 0))
    {
        monthDays[1] = 29;
    }

    // Calculate first day of the year
    for (i = 1; i < year; i++)
    {
        if ((i % 400 == 0) ||
            (i % 4 == 0 && i % 100 != 0))
            firstDay += 366;
        else
            firstDay += 365;
    }

    firstDay = firstDay % 7;

    // Print calendar
    for (month = 0; month < 12; month++)
    {
        printf("\n\n       %s %d\n", months[month], year);
        printf(" Sun Mon Tue Wed Thu Fri Sat\n");

        for (i = 0; i < firstDay; i++)
            printf("    ");

        days = monthDays[month];

        for (day = 1; day <= days; day++)
        {
            printf("%4d", day);

            if ((firstDay + day) % 7 == 0)
                printf("\n");
        }

        firstDay = (firstDay + days) % 7;
    }

    printf("\n");

    return 0;
}
