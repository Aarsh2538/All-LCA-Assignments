#include <stdio.h>
    int main(){
        float a, b, result;
        int choice;
        printf("enter 2 numbers a&b (seprated by a comma):");
        scanf("%f,%f",&a, &b);
        
        printf("1. addition\n");
         printf("2. subtraction\n");
          printf("3. multiplication\n");
           printf("4. divison\n");
           scanf("%d" , &choice);
           switch (choice){
        case 1:
        result= a+b;
        printf("addition = %f\n", result);
        break;
          case 2:
        result= a-b;
        printf("subtraction = %f\n", result);
        break;
        case 3:
        result= a*b;
        printf("multiplication = %f\n", result);
        break;
        case 4:
        if (b != 0){
        result= a/b;
        printf("division = %f\n", result);
        } else{
            printf("division by zero is not possible\n");
        }
        break;
        default:
        printf("invalid choice\n");
        
    }
     return 0;
    }
