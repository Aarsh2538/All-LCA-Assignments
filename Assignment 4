#include <stdio.h>

int main()
{
    int a[3][3], b[3][3], sum[3][3];
    int i, j, r, c, choice;

    while (1)
    {
        printf("\n===== MENU =====\n");
        printf("1. Add Matrices\n");
        printf("2. Exit Program\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        if (choice == 2)
        {
            printf("Program exited successfully.\n");
            break;
        }

        if (choice != 1)
        {
            printf("Invalid choice! Try again.\n");
            continue;
        }

        printf("Enter number of rows (1-3): ");
        scanf("%d", &r);

        printf("Enter number of columns (1-3): ");
        scanf("%d", &c);

        if (r < 1 || r > 3 || c < 1 || c > 3)
        {
            printf("Invalid size! Rows and columns must be between 1 and 3.\n");
            continue;
        }

        printf("\nEnter elements of first matrix:\n");
        for (i = 0; i < r; i++)
        {
            for (j = 0; j < c; j++)
            {
                printf("Enter element [%d][%d]: ", i + 1, j + 1);
                scanf("%d", &a[i][j]);
            }
        }

        printf("\nEnter elements of second matrix:\n");
        for (i = 0; i < r; i++)
        {
            for (j = 0; j < c; j++)
            {
                printf("Enter element [%d][%d]: ", i + 1, j + 1);
                scanf("%d", &b[i][j]);
            }
        }

        printf("\nSum of the two matrices:\n");
        for (i = 0; i < r; i++)
        {
            for (j = 0; j < c; j++)
            {
                sum[i][j] = a[i][j] + b[i][j];
                printf("%d\t", sum[i][j]);
            }
            printf("\n");
        }
    }

    return 0;
}
